# Long-cache static assets (filenames don't change often; bust via path or query)
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

# CSS and JS — cache for a week, allow revalidation
/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800

# HTML — short cache, must revalidate so deploys go live fast
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Default for everything else (folders, root)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
